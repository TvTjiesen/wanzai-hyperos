<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      相機：只給「掃碼簽到」用（學在城院的掃碼在網頁版靠微信 JSSDK，
      我們的原生頁要自己掃）。**運行時仍會再問一次**（Android 6+），
      且拒絕後 App 其餘功能完全不受影響 —— 掃碼是唯一用到它的地方。
    -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
      麥克風：只給 WebView 裡的網頁用（門戶/校園網有些表單要錄音）。
      WebChromeClient.onPermissionRequest 只放行相機與麥克風兩樣，
      用戶拒絕時網頁自己失敗，App 其餘功能不受影響。
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      通知：上课前提醒要弹一条。Android 13 起这是运行时权限，用户不给就一条也弹不出来 ——
      设置页那颗开关打开时会当场申请一次，被拒就把开关退回「关」，不留一个假的已开。
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      精确闹钟：8:00 的课要在 7:50 响。不精确的窗口闹钟会被系统攒到一起，
      2026-10-30 真机实测：只有 SCHEDULE_EXACT_ALARM 时 dumpsys alarm 记的是
      window=+1h0m0s，也就是「一小时内随便什么时候响」—— 课前提醒迟到一小时等于没有。
      所以再加 USE_EXACT_ALARM（系统直接给，不需要用户去设置里点一次；
      「日历 / 闹钟」正是它设计的场景）。两条都留着：
      USE_EXACT_ALARM 不认的老系统还能回落 SCHEDULE_EXACT_ALARM。
      真排不上精确闹钟时 ReminderScheduler 退回不精确闹钟，不崩。
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- 重启后重建闹钟：AlarmManager 的闹钟重启就全没了，清单在 ReminderStore。 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      ★ 不寫 `<uses-feature android:name="android.hardware.camera" android:required="true">`：
      那會讓「沒有相機的設備」在應用商店裡看不到這個 App。
      相機只是其中一個功能，不該成為安裝的前提。
    -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!--
      ★ 不再用 android:usesCleartextTraffic="true"（那是对全网放行明文）。
      改为只对 hzcu.edu.cn 及其子域放行，见 res/xml/network_security_config.xml 的说明。
    -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.WanzaiHyperOS">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.WanzaiHyperOS">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              ★ B17：接收智慧公寓的入口連結（`zhgy.hzcu.edu.cn/mob/zuccindex.html?code=…`）。

              為什麼要這個：那個連結是使用者在**別的 App**（釘釘／瀏覽器／聊天）裡
              拿到的，而它的 `code` 是**個人憑證**，只能由使用者自己帶過來。
              有了這個 intent-filter，使用者在任何地方點那個連結、
              或把它「分享」到本 App，就會直接落到智慧公寓並自動填好 ——
              不必手動複製再貼。

              ⚠️ 只收 `zhgy.hzcu.edu.cn` 這一個 host、只收 `/mob/` 下的路徑：
              收得越窄越好。這個 App **不當通用瀏覽器**，
              也不該被任何網站用奇怪的 scheme 叫起來。
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="http"
                    android:host="zhgy.hzcu.edu.cn"
                    android:pathPrefix="/mob/" />
                <data
                    android:scheme="https"
                    android:host="zhgy.hzcu.edu.cn"
                    android:pathPrefix="/mob/" />
            </intent-filter>
        </activity>

        <!--
          上课提醒的闹钟接收器。exported=false：只有本 App 自己的 PendingIntent 能触发它。
        -->
        <receiver
            android:name=".data.reminder.ClassReminderReceiver"
            android:exported="false" />

        <!-- 开机 / 覆盖安装后照清单把闹钟重挂一遍（这两条广播是系统发的，必须 exported）。 -->
        <receiver
            android:name=".data.reminder.ReminderBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
