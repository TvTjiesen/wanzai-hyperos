<?xml version="1.0" encoding="utf-8"?>
<!--
    全 App 的文案资源。

    ══════════════════════════════════════════════════════════════════════
    规则（见 docs/COPY-TERMS.md，那是本档的依据）
    ══════════════════════════════════════════════════════════════════════

    1. 一律**简体中文**（业主 2026-10-20 明确要求：界面上的繁体全部改成简体）。
       术语按大陆习惯，不是机器直转：搜尋→搜索、重新整理→刷新、贴上→粘贴。
    2. 陈述句、**无感叹号、无 emoji、无语气词**。
    3. **不指责使用者**：讲系统状态，不讲「你的网络有问题」。
    4. 状态文案的结构固定为「**发生了什么 + 下一步做什么**」
       （规范 §10：「只写『加载失败』= 没做设计」）。
    5. 「未知」与「0」**必须分开**：未知用 `—`，确实 0 才写 `0`。

    ══════════════════════════════════════════════════════════════════════
    命名惯例
    ══════════════════════════════════════════════════════════════════════

    state_*      状态占位（加载/空/错误/无网/旧数据/登录失效）
    action_*     动作（重试、刷新、退出登录…）
    common_*     通用名词（确定、取消…）
    page_*       页面标题
    meta_*       弱化信息（版本、免责）

    目前**只迁移了最高频的部分**（状态文案 + 主壳 + 常用动作）。
    其余约 100 处仍在 Composable 里，迁移顺序见 docs/COPY-TERMS.md §7。
-->
<resources>
    <!--
      应用名（2026-11-07 业主：「名称再想一个，这个我不满意，听着不够可爱」）。

      「鲸集」：鲸是鲸鱼娘（桌面图标 / 登录 / 关于三层入口的角色），集是「把分散的
      校园系统聚到一处」。两个字、开口音收尾，念起来轻；比「城院集」短一半，
      也避开了把校名写进产品名带来的"官方"歧义。

      备选（业主可一句话换掉，见 docs/BRAND-NAME.md 的取舍表）：
        · 鲸屿  —— 更柔，但"屿"是静态地名，说不出"聚合"
        · 城院同学 —— 人格感最强，工具属性最弱
    -->
    <string name="app_name">鲸集</string>

    <!-- ══════════════ 状态占位（docs/COPY-TERMS.md §3 定稿，可直接抄）══════════════ -->

    <!-- 加载中。省略号用单个 U+2026，不是三个点。 -->
    <string name="state_loading">正在加载…</string>

    <!-- 空。★ 说明里必须写「不是加载失败」——
         本项目栽过「界面显示没有数据、而其实取数失败」的坑（B18）。 -->
    <string name="state_empty_title">暂无内容</string>
    <string name="state_empty_detail">服务端明确返回了空结果（不是加载失败，不必重试）</string>

    <!-- 错误。★ 必须有下一步（下方「重试」）。 -->
    <string name="state_error_title">加载失败</string>
    <string name="state_error_detail">取不到内容，可能是网络或服务端异常。下方「重试」可再试一次；若一直失败，请稍后再看。</string>

    <!-- 无网。不指责使用者：「网络不可达」而不是「你的网络有问题」。 -->
    <string name="state_offline_title">网络不可达</string>
    <string name="state_offline_detail">请检查网络后重试。已显示的内容可能不是最新的。</string>

    <!-- 旧数据。 -->
    <string name="state_stale_title">显示的是缓存数据</string>
    <string name="state_stale_detail">下拉刷新可取得最新内容。</string>

    <!-- 登录失效。★ 必须与「错误」分开：这个要引导去登录，重试没用。
         2026-11-08：原文写「请到『我的』重新登录」—— 「我的」这个 tab 早就摘了
         （MinePage 在 DeadPageRegistry 里登记为死页），现在点不到任何叫「我的」的地方，
         等于把用户指去一面墙。改成账号页：那一页七行逐条列着每个来源「去哪登」，
         点一行就跳到对应入口（不代填密码）。 -->
    <string name="state_session_expired_title">登录状态已失效</string>
    <string name="state_session_expired_detail">请到「设置 › 账号与连接」点这一项，按提示重新登录。</string>

    <!-- ══════════════ 动作 ══════════════ -->

    <string name="action_retry">重试</string>
    <string name="action_refresh">刷新</string>
    <string name="action_back">返回</string>
    <string name="action_close">关闭</string>
    <string name="action_cancel">取消</string>
    <string name="action_confirm">确定</string>
    <string name="action_search">搜索</string>
    <string name="action_logout">退出登录</string>
    <string name="action_relogin">重新登录</string>

    <!-- ══════════════ 底部导航（主壳）══════════════ -->

    <string name="tab_home">首页</string>
    <string name="tab_apps">应用</string>
    <string name="tab_messages">消息</string>
    <string name="tab_mine">我的</string>

    <!-- ══════════════ 弱化信息（规范 §12 第 5 条：11~12sp 小灰字）══════════════ -->

    <string name="meta_loading_please_wait">请稍候</string>

    <!-- ══════════════ 未知数量（docs/COPY-TERMS.md §4）══════════════ -->

    <!-- 「不知道」用破折号，**不能用 0** —— 显示 0 等于说「确实没有」。 -->
    <string name="value_unknown">—</string>
</resources>
